# Gateway's own HTTP listener and local management endpoints.
SERVER_PORT=8080
GATEWAY_MANAGEMENT_BASE_PATH=/actuator
GATEWAY_HEALTH_PATH=health
GATEWAY_INFO_PATH=info
# Use framework only behind a trusted proxy that replaces forwarded headers.
GATEWAY_FORWARD_HEADERS_STRATEGY=none
# Comma-separated browser origins, with scheme and no path.
GATEWAY_CORS_ALLOWED_ORIGINS=https://vigoapp.ir

# Upstream hosts are DNS names on the shared Docker network. Use localhost or
# another reachable host when running the Gateway directly on your machine.
AUTH_SCHEME=http
AUTH_HOST=auth
AUTH_PORT=8080
AUTH_ROUTE_PREFIX=/api/v1/auth
AUTH_JWKS_PATH=/.well-known/jwks.json

USER_SCHEME=http
USER_HOST=user
USER_PORT=8081
USER_ROUTE_PREFIX=/api/v1/users
USER_COACHES_ROUTE_PREFIX=/api/v1/coaches
USER_ADMIN_COACHES_ROUTE_PREFIX=/api/v1/admin/coaches

STORAGE_SCHEME=http
STORAGE_HOST=storage
STORAGE_PORT=8083
STORAGE_ROUTE_PREFIX=/api/v1/files
STORAGE_RESPONSE_TIMEOUT_MS=120000

# Reserved for Notification. It currently has no Gateway route.
NOTIFICATION_SCHEME=http
NOTIFICATION_HOST=notification
NOTIFICATION_PORT=

GATEWAY_CONNECT_TIMEOUT_MS=1000
GATEWAY_RESPONSE_TIMEOUT=5s

# Match Auth's sampling rate for traces that start at the Gateway.
GATEWAY_TRACING_SAMPLING_PROBABILITY=1.0

# Host mode sends JSON lines to this Vector TCP endpoint. Leave empty for console only.
LOGGING_VECTOR_DESTINATION=localhost:5044
# The Gateway image automatically sets LOGGING_VECTOR_MODE=docker for JSON stdout only.
